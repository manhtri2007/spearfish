local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local Player = Players.LocalPlayer

-- ==========================================
-- 1. TẠO GIAO DIỆN (GUI) CƠ BẢN
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
-- Cố gắng bỏ vào CoreGui để chống bị phát hiện, nếu không được thì bỏ vào PlayerGui
local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = Player:WaitForChild("PlayerGui")
end

local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 200, 0, 150) -- Đã chỉnh lên 150 để chứa vừa 3 nút
Frame.Position = UDim2.new(0.5, -100, 0.2, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Active = true
Frame.Draggable = true

local UIListLayout = Instance.new("UIListLayout", Frame)
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder

local JoinBtn = Instance.new("TextButton", Frame)
JoinBtn.Size = UDim2.new(1, 0, 0, 50)
JoinBtn.Text = "JOIN VIP SERVER"
JoinBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
JoinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
JoinBtn.Font = Enum.Font.GothamBold
JoinBtn.TextSize = 14

local HopBtn = Instance.new("TextButton", Frame)
HopBtn.Size = UDim2.new(1, 0, 0, 50)
HopBtn.Text = "SERVER HOP"
HopBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
HopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
HopBtn.Font = Enum.Font.GothamBold
HopBtn.TextSize = 14

local CloseBtn = Instance.new("TextButton", Frame)
CloseBtn.Size = UDim2.new(1, 0, 0, 50)
CloseBtn.Text = "CLOSE GUI"
CloseBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14

-- ==========================================
-- 2. XỬ LÝ CHỨC NĂNG NÚT BẤM
-- ==========================================

-- Nút Xóa GUI
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Nút Server Hop (MỚI THÊM)
HopBtn.MouseButton1Click:Connect(function()
    HopBtn.Text = "HOPPING..."
    HopBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    
    local reExecuteCode = [[
        loadstring(game:HttpGet("https://raw.githubusercontent.com/manhtri2007/spearfish/refs/heads/main/cac"))()
    ]]
    
    if queue_on_teleport then
        pcall(function() queue_on_teleport(reExecuteCode) end)
    elseif syn and syn.queue_on_teleport then
        pcall(function() syn.queue_on_teleport(reExecuteCode) end)
    end
    
    task.spawn(function()
        pcall(function()
            local HttpService = game:GetService("HttpService")
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            local response = game:HttpGet(url)
            local data = HttpService:JSONDecode(response)
            
            local serverId = nil
            if data and data.data then
                for _, v in pairs(data.data) do
                    if type(v) == "table" and v.playing and v.maxPlayers then
                        if v.playing < v.maxPlayers and v.id ~= game.JobId then
                            serverId = v.id
                            break
                        end
                    end
                end
            end

            if serverId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, Player)
            else
                HopBtn.Text = "NOT FOUND"
                task.wait(2)
                HopBtn.Text = "SERVER HOP"
                HopBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
            end
        end)
    end)
end)

-- Nút Join Server VIP & Tự Động Chạy Lại Script
JoinBtn.MouseButton1Click:Connect(function()
    JoinBtn.Text = "TELEPORTING..."
    JoinBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    
    -- MÃ LỆNH TỰ CHẠY LẠI:
    local reExecuteCode = [[
        loadstring(game:HttpGet("https://raw.githubusercontent.com/manhtri2007/spearfish/refs/heads/main/cac"))()
    ]]
    
    -- Đặt lịch chạy lại script cho Executor khi sang server mới
    if queue_on_teleport then
        queue_on_teleport(reExecuteCode)
    elseif syn and syn.queue_on_teleport then
        syn.queue_on_teleport(reExecuteCode)
    else
        warn("Executor của bạn không hỗ trợ queue_on_teleport!")
    end
    
    -- Đã fix: Dùng game.PlaceId để tránh lỗi sai map phụ
    local placeId = game.PlaceId 
    local jobId = game.JobId
    
    -- Lệnh Dịch Chuyển
    pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, Player)
    end)
end)
